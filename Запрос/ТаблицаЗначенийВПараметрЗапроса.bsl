&НаСервере
Процедура ЗаполнитьСписокВыборкойВозможнымиВариантами()
	ТипыФайлов = Метаданные.ОпределяемыеТипы.ПрисоединенныйФайл.Тип.Типы();
	ВозможныеВарианты = Новый ТаблицаЗначений;
	ВозможныеВарианты.Колонки.Добавить("Значение", 		ОбщегоНазначения.ОписаниеТипаСтрока(150));
	ВозможныеВарианты.Колонки.Добавить("Представление", ОбщегоНазначения.ОписаниеТипаСтрока(150));
	ВозможныеВарианты.Колонки.Добавить("Пометка", 		Новый ОписаниеТипов("Булево"));
	Для Каждого СправочникФайлов Из ТипыФайлов Цикл
		МетаданныеСправочника = Метаданные.НайтиПоТипу(СправочникФайлов);
		НоваяСтрока 				= ВозможныеВарианты.Добавить();
		
		НоваяСтрока.Значение 		= МетаданныеСправочника.Имя;
		НоваяСтрока.Представление 	= МетаданныеСправочника.Синоним;
		НоваяСтрока.Пометка 		= ЛОжь;
	КонецЦикла;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТЗ.Значение КАК Значение,
	|	ТЗ.Представление КАК Представление,
	|	ТЗ.Пометка КАК Пометка
	|ПОМЕСТИТЬ ВозможныеВарианты
	|ИЗ
	|	&ВозможныеВарианты КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВозможныеВарианты.Значение КАК Значение,
	|	ВозможныеВарианты.Представление КАК Представление,
	|	ВЫБОР
	|		КОГДА YА_ВыгружаемыеОбъектыСрезПоследних.Выгружать ЕСТЬ NULL
	|			ТОГДА ВозможныеВарианты.Пометка
	|		ИНАЧЕ YА_ВыгружаемыеОбъектыСрезПоследних.Выгружать
	|	КОНЕЦ КАК Пометка
	|ИЗ
	|	ВозможныеВарианты КАК ВозможныеВарианты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.YА_ВыгружаемыеОбъекты.СрезПоследних КАК YА_ВыгружаемыеОбъектыСрезПоследних
	|		ПО ВозможныеВарианты.Значение = YА_ВыгружаемыеОбъектыСрезПоследних.НазваниеОбъекта";
	
	Запрос.УстановитьПараметр("ВозможныеВарианты", ВозможныеВарианты);
	
	Результат = Запрос.Выполнить();
	ВыборкаРезультата = Результат.Выбрать();
	Пока ВыборкаРезультата.Следующий() Цикл
		ВозможныеЭлементы.Добавить(ВыборкаРезультата.Значение, ВыборкаРезультата.Представление, ВыборкаРезультата.Пометка);
	КонецЦикла;
КонецПроцедуры
