&НаСервере
Процедура СохранитьПараметрыОтбора()
	ТекПользователь = Пользователи.ТекущийПользователь();
	Для каждого ЭлементПараметра Из ДанныеДляОтправки.Параметры.Элементы Цикл
		Значение = ?(ТипЗнч(ЭлементПараметра.Значение) = Тип("СтандартнаяДатаНачала"), ЭлементПараметра.Значение.Дата, ЭлементПараметра.Значение);
		ОбщегоНазначения.ХранилищеНастроекДанныхФормСохранить("ВнешняОбработка.YA_ОтправкаФайловНаYandexDisk",
																Строка(ЭлементПараметра.Параметр),
																Значение, "",ТекПользователь, Истина); 
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьПараметрыОтбора()
	СохраненныеПараметры = СохраненныеПараметрыОтбора();
	Для каждого СохраненныйПараметр Из СохраненныеПараметры Цикл
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДанныеДляОтправки, СохраненныйПараметр.Ключ, СохраненныйПараметр.Значение, Истина);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция СохраненныеПараметрыОтбора()
	ТекПользователь = Пользователи.ТекущийПользователь();
	СохраненныеПараметры = Новый Структура();
	Для каждого ЭлементПараметра Из ДанныеДляОтправки.Параметры.Элементы Цикл
		ЗначениеОтбора = ОбщегоНазначения.ХранилищеНастроекДанныхФормЗагрузить("ВнешняОбработка.YA_ОтправкаФайловНаYandexDisk", Строка(ЭлементПараметра.Параметр),,,ТекПользователь);
		Если ЗначениеЗаполнено(ЗначениеОтбора) Тогда
			СохраненныеПараметры.Вставить(Строка(ЭлементПараметра.Параметр), ЗначениеОтбора);
		КонецЕсли;
	КонецЦикла; 
	Возврат СохраненныеПараметры;
КонецФункции